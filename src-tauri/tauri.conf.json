{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "paim",
  "version": "0.1.4",
  "identifier": "com.paim.perphyyoung",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm version:sync && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "paim",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
