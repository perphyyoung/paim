{
  "name": "paim",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "pnpm format:ui && pnpm format:rs",
    "format:ui": "oxfmt src/",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt src/ --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm format && vue-tsc --noEmit && pnpm build && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "vue": "^3.5",
    "vue-router": "4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5",
    "autoprefixer": "^10.4",
    "oxfmt": "^0.65.0",
    "postcss": "^8.4",
    "tailwindcss": "^3.4",
    "typescript": "^5.6",
    "vite": "^6",
    "vue-tsc": "^2"
  }
}
