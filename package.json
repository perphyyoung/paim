{
  "name": "paim",
  "private": true,
  "version": "0.2.21",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "release": "tauri build",
    "build": "vite build",
    "build:rs": "cargo build --manifest-path src-tauri/Cargo.toml",
    "gen:bindings": "node scripts/gen-bindings.mjs",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e",
    "preview": "vite preview",
    "format": "pnpm format:ui && pnpm format:rs",
    "format:ui": "oxfmt src/ e2e/",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt src/ e2e/ --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "check": "pnpm format && pnpm build:rs && pnpm gen:bindings && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "vue": "^3.5",
    "vue-router": "4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5",
    "autoprefixer": "^10.4",
    "oxfmt": "^0.65.0",
    "postcss": "^8.4",
    "tailwindcss": "^3.4",
    "typescript": "^5.6",
    "vite": "^6",
    "vue-tsc": "^2"
  }
}
